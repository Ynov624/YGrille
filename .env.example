# Variables consommées par docker-compose.yml. Copie ce fichier en `.env`
# (non versionné) et remplace les valeurs avant `docker compose up`.

DB_ROOT_PASSWORD=ygrille-root
DB_NAME=grilles
DB_USER=grilles
DB_PASSWORD=Admingrilles

# Génère une valeur aléatoire, ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Envoi du code de vérification à l'inscription (https://resend.com/api-keys)
RESEND_API_KEY=
MAIL_FROM=Grilles de notation <onboarding@resend.dev>
