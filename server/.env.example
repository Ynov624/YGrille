# Secret utilisé pour signer les tokens JWT. Génère une valeur aléatoire,
# par ex. avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Envoi du code de vérification à l'inscription (https://resend.com/api-keys).
# Sans clé, en dev, le code est affiché dans la console du serveur.
RESEND_API_KEY=
MAIL_FROM=Grilles de notation <onboarding@resend.dev>

# Base de données. Laisser vide en dev : le serveur utilise alors un fichier SQLite
# local (server/data/ygrille.db). Renseigner uniquement pour cibler la base Turso
# (`turso db show ygrille --url`, `turso db tokens create ygrille`).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
